# Copy to .env and fill in. These are placeholders. Do not commit a real .env.

# sqlite:///./data/prism.db is the local default. Postgres example:
# PRISM_DATABASE_URL=postgresql+psycopg://prism:prism@127.0.0.1:54329/prism
PRISM_DATABASE_URL=sqlite:///./data/prism.db

PRISM_DEMO_MODE=true
PRISM_AUTO_SEED=true
PRISM_AUTO_MIGRATE=1
# embedded runs the worker inside the API process. Use external with `python -m app.worker`.
PRISM_WORKER_MODE=embedded
PRISM_STAGE_DELAY_MS=450

PRISM_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
PRISM_GITHUB_API_BASE=https://api.github.com
PRISM_GITHUB_TOKEN=

# mock is the deterministic provider. A hosted model is not called in this build.
PRISM_LLM_PROVIDER=mock
PRISM_OPENAI_API_KEY=
PRISM_OPENAI_BASE_URL=https://api.openai.com/v1

# subprocess is demo-fixture only. docker is the isolation path and still shares a kernel.
PRISM_SANDBOX_DRIVER=subprocess
PRISM_SANDBOX_IMAGE=python:3.12-slim
PRISM_SANDBOX_TIMEOUT_SECONDS=20
PRISM_MAX_REPAIR_ATTEMPTS=3
PRISM_TOKEN_BUDGET=24000

PRISM_ALLOWED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
PRISM_DEMO_USER_EMAIL=demo@prism.local
PRISM_LOG_LEVEL=INFO
PRISM_OTLP_ENDPOINT=

# Frontend proxy target when Next is not started by scripts/dev.sh
BACKEND_URL=http://127.0.0.1:8741
